# Copy to .env. Loaded by pnpm dev and pnpm start.
# Restart the command after editing. Existing shell variables take precedence.
# The app runs without this file; the PDS check will just report "not configured".

# Dev server ports
DEV_PORT=5173
API_PORT=3000

# Production server
PORT=3000
HOST=127.0.0.1
APP_NAME=atproto-starter

# AT Protocol PDS endpoint to check for reachability.
# For local dev, run atproto-sandbox and point this at it (http://127.0.0.1:2583).
# PDS_URL=https://your-pds.example
